# ============================================================
# RK3506 网关裁剪 — Buildroot 需要【保留/开启】的包
# ============================================================

# ──────────────────────────────────────
# [1] 系统基础配置
# ──────────────────────────────────────
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
# 或使用 musl 更省空间:
# BR2_TOOLCHAIN_BUILDROOT_MUSL=y

BR2_TARGET_GENERIC_HOSTNAME="rk3506-gateway"
BR2_TARGET_GENERIC_ISSUE="RK3506 Gateway System"
BR2_SYSTEM_DHCP="eth0"

# Init 系统 — 用 BusyBox init 最省空间
BR2_INIT_BUSYBOX=y
# BR2_INIT_SYSTEMD is not set
# BR2_INIT_SYSV is not set

# /dev 管理
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y

# ──────────────────────────────────────
# [2] 编译优化
# ──────────────────────────────────────
BR2_OPTIMIZE_S=y
BR2_STRIP_strip=y
BR2_ENABLE_LTO=y
BR2_SSP_NONE=y

# ──────────────────────────────────────
# [3] ★ BusyBox — 轻量系统工具
# ──────────────────────────────────────
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
# BusyBox 提供: sh, vi, ifconfig, ip, route, ping,
#   telnetd, ftpd, httpd, syslogd, crond 等

# ──────────────────────────────────────
# [4] ★ CAN 工具
# ──────────────────────────────────────
BR2_PACKAGE_CAN_UTILS=y
BR2_PACKAGE_LIBSOCKETCAN=y
BR2_PACKAGE_IPROUTE2=y

# ──────────────────────────────────────
# [5] ★ 网络基础工具
# ──────────────────────────────────────
BR2_PACKAGE_IPTABLES=y
BR2_PACKAGE_BRIDGE_UTILS=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_DROPBEAR=y
# 或 openssh (更大但功能更全):
# BR2_PACKAGE_OPENSSH=y

# ──────────────────────────────────────
# [6] ★ Qt5 — 精选模块
# ──────────────────────────────────────
BR2_PACKAGE_QT5=y
BR2_PACKAGE_QT5BASE=y
BR2_PACKAGE_QT5BASE_NETWORK=y
BR2_PACKAGE_QT5BASE_CONCURRENT=y
BR2_PACKAGE_QT5BASE_SQL=y
BR2_PACKAGE_QT5BASE_SQLITE=y

# 有屏幕时:
BR2_PACKAGE_QT5BASE_GUI=y
BR2_PACKAGE_QT5BASE_WIDGETS=y
BR2_PACKAGE_QT5BASE_LINUXFB=y
BR2_PACKAGE_QT5BASE_FONTCONFIG=y
BR2_PACKAGE_QT5BASE_GIF=y
BR2_PACKAGE_QT5BASE_JPEG=y
BR2_PACKAGE_QT5BASE_PNG=y

# 无屏幕时以上 GUI/Widgets 全改为 not set

# GL 相关全关:
# BR2_PACKAGE_QT5BASE_OPENGL is not set
# BR2_PACKAGE_QT5BASE_EGLFS is not set

# Qt 附加模块:
BR2_PACKAGE_QT5SERIALPORT=y
BR2_PACKAGE_QT5SERIALBUS=y

# 以下 Qt 模块全部关闭:
# BR2_PACKAGE_QT5MULTIMEDIA is not set
# BR2_PACKAGE_QT5WEBENGINE is not set
# BR2_PACKAGE_QT5WEBKIT is not set
# BR2_PACKAGE_QT5WEBVIEW is not set
# BR2_PACKAGE_QT5WEBSOCKETS is not set
# BR2_PACKAGE_QT5WEBCHANNEL is not set
# BR2_PACKAGE_QT5CONNECTIVITY is not set
# BR2_PACKAGE_QT5LOCATION is not set
# BR2_PACKAGE_QT5SENSORS is not set
# BR2_PACKAGE_QT5SVG is not set
# BR2_PACKAGE_QT5CHARTS is not set
# BR2_PACKAGE_QT5DATAVIS3D is not set
# BR2_PACKAGE_QT53D is not set
# BR2_PACKAGE_QT5GRAPHICALEFFECTS is not set
# BR2_PACKAGE_QT5IMAGEFORMATS is not set
# BR2_PACKAGE_QT5VIRTUALKEYBOARD is not set
# BR2_PACKAGE_QT5WAYLAND is not set
# BR2_PACKAGE_QT5X11EXTRAS is not set
# BR2_PACKAGE_QT5QUICKCONTROLS is not set
# BR2_PACKAGE_QT5QUICKCONTROLS2 is not set
# BR2_PACKAGE_QT5DECLARATIVE is not set
# BR2_PACKAGE_QT5SCRIPT is not set
# BR2_PACKAGE_QT5TOOLS is not set
# BR2_PACKAGE_QT5TRANSLATIONS is not set
# BR2_PACKAGE_QT5DOC is not set

# ICU 关闭 (节省 20-30MB):
# BR2_PACKAGE_QT5BASE_ICU is not set

# ──────────────────────────────────────
# [7] ★ 串口调试工具 (可选，调试完可去掉)
# ──────────────────────────────────────
# BR2_PACKAGE_PICOCOM=y
# BR2_PACKAGE_MINICOM=y

# ──────────────────────────────────────
# [8] 文件系统镜像
# ──────────────────────────────────────
# SquashFS (只读, 压缩率高):
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS_XZ=y

# ext4 (可读写):
# BR2_TARGET_ROOTFS_EXT2=y
# BR2_TARGET_ROOTFS_EXT2_4=y
# BR2_TARGET_ROOTFS_EXT2_SIZE="80M"

# UBIFS (SPI NAND):
# BR2_TARGET_ROOTFS_UBIFS=y
# BR2_TARGET_ROOTFS_UBIFS_LEBSIZE=0x1F000
# BR2_TARGET_ROOTFS_UBIFS_MINIOSIZE=0x800
# BR2_TARGET_ROOTFS_UBIFS_MAXLEBCNT=2048

# ──────────────────────────────────────
# [9] 基础库
# ──────────────────────────────────────
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBJSON_C=y
