# ============================================================
# RK3506 网关裁剪 — BusyBox 需要保留的命令
# 在 busybox menuconfig 中仅开启以下命令，其余关闭
# ============================================================

# ──────────────────────────────────────
# [1] 核心Shell
# ──────────────────────────────────────
CONFIG_ASH=y
CONFIG_ASH_BASH_COMPAT=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_FEATURE_SH_IS_ASH=y

# ──────────────────────────────────────
# [2] 文件操作
# ──────────────────────────────────────
CONFIG_LS=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_CAT=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_ECHO=y
CONFIG_PRINTF=y
CONFIG_TOUCH=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_LN=y
CONFIG_FIND=y
CONFIG_XARGS=y
CONFIG_DU=y
CONFIG_DF=y
CONFIG_STAT=y
CONFIG_WC=y
CONFIG_SORT=y
CONFIG_UNIQ=y
CONFIG_CUT=y
CONFIG_TR=y
CONFIG_TEE=y
CONFIG_DD=y
CONFIG_SYNC=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_YES=y
CONFIG_SEQ=y
CONFIG_TEST=y
CONFIG_READLINK=y
CONFIG_REALPATH=y
CONFIG_DIRNAME=y
CONFIG_BASENAME=y
CONFIG_MD5SUM=y
CONFIG_SHA256SUM=y

# ──────────────────────────────────────
# [3] 进程管理
# ──────────────────────────────────────
CONFIG_PS=y
CONFIG_KILL=y
CONFIG_KILLALL=y
CONFIG_TOP=y
CONFIG_FREE=y
CONFIG_UPTIME=y
CONFIG_REBOOT=y
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_SLEEP=y
CONFIG_USLEEP=y
CONFIG_NOHUP=y
CONFIG_NICE=y
CONFIG_PIDOF=y

# ──────────────────────────────────────
# [4] ★ 网络工具
# ──────────────────────────────────────
CONFIG_IFCONFIG=y
CONFIG_IP=y
CONFIG_ROUTE=y
CONFIG_PING=y
CONFIG_TRACEROUTE=y
CONFIG_NETSTAT=y
CONFIG_ARP=y
CONFIG_WGET=y
CONFIG_HOSTNAME=y
CONFIG_TELNET=y
CONFIG_TELNETD=y
CONFIG_NC=y
CONFIG_BRCTL=y

# ──────────────────────────────────────
# [5] 文本编辑
# ──────────────────────────────────────
CONFIG_VI=y
CONFIG_GREP=y
CONFIG_SED=y
CONFIG_AWK=y
CONFIG_DIFF=y

# ──────────────────────────────────────
# [6] 系统初始化
# ──────────────────────────────────────
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_SYSLOGD=y
CONFIG_KLOGD=y
CONFIG_LOGGER=y
CONFIG_CROND=y
CONFIG_CRONTAB=y

# ──────────────────────────────────────
# [7] 挂载/设备
# ──────────────────────────────────────
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_LOSETUP=y
CONFIG_MDEV=y
CONFIG_BLKID=y
CONFIG_FDISK=y
CONFIG_MKFS_EXT2=y
CONFIG_MKFS_VFAT=y
CONFIG_FSCK=y
CONFIG_SWAPON=y
CONFIG_SWAPOFF=y

# ──────────────────────────────────────
# [8] 其他实用工具
# ──────────────────────────────────────
CONFIG_DATE=y
CONFIG_HWCLOCK=y
CONFIG_DMESG=y
CONFIG_HEXDUMP=y
CONFIG_XXD=y
CONFIG_DEVMEM=y
CONFIG_I2CGET=y
CONFIG_I2CSET=y
CONFIG_I2CDUMP=y
CONFIG_I2CDETECT=y
CONFIG_STTY=y
CONFIG_UDHCPC=y
CONFIG_UDHCPD=y
CONFIG_NTPD=y
CONFIG_TAR=y
CONFIG_GZIP=y
CONFIG_GUNZIP=y
CONFIG_BUNZIP2=y
CONFIG_UNZIP=y
CONFIG_XZ=y

# ──────────────────────────────────────
# [9] 关闭不需要的 BusyBox 命令
# ──────────────────────────────────────
# CONFIG_FEATURE_HTTPD is not set        # 内置HTTP服务 (如需要可开启)
# CONFIG_FTPD is not set                 # FTP服务 (如需要可开启)
# CONFIG_FTPGET is not set
# CONFIG_FTPPUT is not set
# CONFIG_DNSD is not set
# CONFIG_INETD is not set
# CONFIG_TFTP is not set
# CONFIG_TFTPD is not set
# CONFIG_UUDECODE is not set
# CONFIG_UUENCODE is not set
# CONFIG_DPKG is not set
# CONFIG_RPM is not set
# CONFIG_MAKEDEVS is not set
# CONFIG_MAN is not set
# CONFIG_LESS is not set                 # 如不需要分页查看
# CONFIG_MICROCOM is not set
# CONFIG_CHAT is not set
# CONFIG_RX is not set
# CONFIG_LSPCI is not set                # 无 PCIe 不需要
# CONFIG_LSUSB is not set                # 不需要 USB 列表
