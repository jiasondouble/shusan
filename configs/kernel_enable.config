# ============================================================
# RK3506 网关裁剪 — 内核需要【保留/开启】的选项
# ============================================================

# ──────────────────────────────────────
# [1] 通用系统配置
# ──────────────────────────────────────
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_AIO=y
CONFIG_INOTIFY_USER=y
CONFIG_FHANDLE=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# 内核压缩
CONFIG_KERNEL_XZ=y
# CONFIG_KERNEL_GZIP is not set
# CONFIG_KERNEL_LZ4 is not set

# 编译优化
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# ──────────────────────────────────────
# [2] ★ CAN 总线 — 必须保留
# ──────────────────────────────────────
CONFIG_NET=y
CONFIG_CAN=y
CONFIG_CAN_RAW=y
CONFIG_CAN_BCM=y
CONFIG_CAN_GW=y
CONFIG_CAN_VCAN=y
CONFIG_CAN_DEV=y
CONFIG_CAN_CALC_BITTIMING=y
CONFIG_CAN_ROCKCHIP=y
CONFIG_CAN_ROCKCHIP_CANFD=y
# 如果驱动名不同，可能是以下之一:
# CONFIG_CAN_RKCANFD=y
# CONFIG_CAN_MCP251X=y          # 如果外挂 SPI CAN
# CONFIG_CAN_SJA1000=y          # 如果外挂 SJA1000

# ──────────────────────────────────────
# [3] ★ 串口 / RS485 — 必须保留
# ──────────────────────────────────────
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_EARLYCON=y
# RS485 支持内置于 8250 驱动中
# 设备树中配置: linux,rs485-enabled-at-boot-time

# ──────────────────────────────────────
# [4] ★ 以太网 — 必须保留
# ──────────────────────────────────────
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_STMICRO=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y
# 或者 RK3506 可能用的 EMAC:
# CONFIG_NET_VENDOR_ROCKCHIP=y
# CONFIG_ROCKCHIP_EMAC=y

# PHY 驱动
CONFIG_PHYLIB=y
CONFIG_PHYLINK=y
CONFIG_REALTEK_PHY=y
CONFIG_MICREL_PHY=y
CONFIG_SMSC_PHY=y
# 根据实际使用的 PHY 芯片选择一个:
# CONFIG_DP83867_PHY=y           # TI DP83867
# CONFIG_AT803X_PHY=y            # Atheros
# CONFIG_MOTORCOMM_PHY=y         # 裕太 YT8511/YT8521
# CONFIG_JL_PHY=y                # 景略 JL2xxx
CONFIG_FIXED_PHY=y
CONFIG_MDIO_DEVICE=y
CONFIG_MDIO_BUS=y

# 网络协议
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_PACKET=y
CONFIG_UNIX=y

# ──────────────────────────────────────
# [5] ★ GPIO — 必须保留
# ──────────────────────────────────────
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_ROCKCHIP=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_ROCKCHIP=y

# ──────────────────────────────────────
# [6] ★ 看门狗 — 推荐保留
# ──────────────────────────────────────
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_DW_WATCHDOG=y
# 或:
# CONFIG_ROCKCHIP_WATCHDOG=y

# ──────────────────────────────────────
# [7] ★ I2C — 保留（EEPROM/RTC 等外设）
# ──────────────────────────────────────
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_RK3X=y
# I2C 外设
CONFIG_EEPROM_AT24=y
CONFIG_RTC_DRV_HYM8563=y
# CONFIG_RTC_DRV_PCF8563=y
# CONFIG_RTC_DRV_DS1307=y

# ──────────────────────────────────────
# [8] ★ SPI — 保留（SPI NAND / SPI NOR）
# ──────────────────────────────────────
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_ROCKCHIP=y
CONFIG_SPI_ROCKCHIP_SFC=y

# ──────────────────────────────────────
# [9] ★ MTD / Flash — 根据Flash类型选择
# ──────────────────────────────────────
CONFIG_MTD=y
CONFIG_MTD_CMDLINE_PARTS=y
CONFIG_MTD_BLOCK=y

# SPI NAND:
CONFIG_MTD_SPI_NAND=y
CONFIG_MTD_UBI=y
CONFIG_MTD_UBI_FASTMAP=y
CONFIG_UBIFS_FS=y
CONFIG_UBIFS_FS_ADVANCED_COMPR=y
CONFIG_UBIFS_FS_LZO=y
CONFIG_UBIFS_FS_ZLIB=y
CONFIG_UBIFS_FS_ZSTD=y

# SPI NOR:
CONFIG_MTD_SPI_NOR=y

# eMMC (走 MMC 子系统):
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y

# ──────────────────────────────────────
# [10] ★ 文件系统 — 仅保留必需
# ──────────────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# ──────────────────────────────────────
# [11] ★ RTC 实时时钟
# ──────────────────────────────────────
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_DRV_RK808=y

# ──────────────────────────────────────
# [12] ★ 电源/时钟/复位
# ──────────────────────────────────────
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_GPIO=y
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_CLK_ROCKCHIP=y
CONFIG_COMMON_CLK_ROCKCHIP=y
CONFIG_RESET_CONTROLLER=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_THERMAL=y

# ──────────────────────────────────────
# [13] DMA
# ──────────────────────────────────────
CONFIG_DMADEVICES=y
CONFIG_PL330_DMA=y

# ──────────────────────────────────────
# [14] Rockchip 平台基础
# ──────────────────────────────────────
CONFIG_ARCH_ROCKCHIP=y
CONFIG_ROCKCHIP_PM_DOMAINS=y
CONFIG_ROCKCHIP_TIMER=y
CONFIG_ROCKCHIP_IOMMU=y
CONFIG_ROCKCHIP_SIP=y
CONFIG_ROCKCHIP_CPUINFO=y
CONFIG_ROCKCHIP_GRF=y
CONFIG_ROCKCHIP_OTP=y
CONFIG_ROCKCHIP_SYSTEM_MONITOR=y
